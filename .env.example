# Server-only database connection. Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=

# demo keeps the current mock adapter; database uses PostgreSQL repositories.
ALPHA_DATA_MODE=demo

# Optional deployment metadata used by health and audit surfaces.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Shopee Open Platform server-side credentials. Never prefix these with NEXT_PUBLIC_.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_TOKEN_ENCRYPTION_KEY=
SHOPEE_REDIRECT_URI=https://alpha-price-ops.vercel.app/api/integrations/shopee/callback
